{
	"info": {
		"_postman_id": "todo-api-collection",
		"name": "Todo API",
		"description": "Postman collection for NestJS Todo API with PostgreSQL",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Todo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Buy groceries\",\n    \"description\": \"Milk, eggs, bread\",\n    \"completed\": false\n}"
				},
				"url": {
					"raw": "{{base_url}}/todo",
					"host": ["{{base_url}}"],
					"path": ["todo"]
				},
				"description": "Create a new todo item"
			}
		},
		{
			"name": "Get All Todos",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/todo",
					"host": ["{{base_url}}"],
					"path": ["todo"]
				},
				"description": "Retrieve all todo items"
			}
		},
		{
			"name": "Get Todo by ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/todo/:id",
					"host": ["{{base_url}}"],
					"path": ["todo", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1",
							"description": "Todo ID"
						}
					]
				},
				"description": "Retrieve a specific todo by ID"
			}
		},
		{
			"name": "Update Todo",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Buy groceries\",\n    \"completed\": true\n}"
				},
				"url": {
					"raw": "{{base_url}}/todo/:id",
					"host": ["{{base_url}}"],
					"path": ["todo", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1",
							"description": "Todo ID"
						}
					]
				},
				"description": "Update an existing todo"
			}
		},
		{
			"name": "Delete Todo",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{base_url}}/todo/:id",
					"host": ["{{base_url}}"],
					"path": ["todo", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1",
							"description": "Todo ID"
						}
					]
				},
				"description": "Delete a todo by ID"
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
}
